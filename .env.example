# Releasesmith environment.
#
# Every key below has a working in-code default, so this file is optional: a
# bare `uvicorn app.main:app` boots with no .env at all. install.sh copies this
# shape into .env and fills SECRET_KEY with a freshly generated value.

# Signing key for the session cookie. Leave empty to use the development
# fallback (fine for local work, set a real random value for anything shared).
SECRET_KEY=

# SQLAlchemy URL. The default is a SQLite file next to the app.
DATABASE_URL=sqlite:///./releasesmith.db
